<?xml version='1.0'?>
<Obfuscator>
  <Var name="InPath" value="." />
  <Var name="OutPath" value=".\Obfuscated" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="true" />
  
  <!-- Important: We MUST keep the Command and App classes visible so Revit can find them -->
  <Module name="CostAnalysis.dll">
    <SkipType name="CostAnalysis.App" />
    <SkipType name="CostAnalysis.MasterCommand" />
    <SkipType name="CostAnalysis.Command.*" />
    <SkipNamespace name="CostAnalysis.UI" />
  </Module>
</Obfuscator>
